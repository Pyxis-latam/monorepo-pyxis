{
  "expo": {
    "name": "Río Limarí Obras",
    "slug": "rio-limari",
    "scheme": "riolimariobras",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.empresasriolimari.obras"
    },
    "android": {
      "package": "cl.empresasriolimari.obras",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#004D69"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Río Limarí Obras usa la cámara para adjuntar fotos a los reportes de avance.",
          "photosPermission": "Río Limarí Obras usa tus fotos para adjuntarlas a los reportes de avance.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#004D69"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6b84fba0-6334-4cbb-9254-88e2f8f50636"
      }
    },
    "owner": "pyxis-latam"
  }
}
